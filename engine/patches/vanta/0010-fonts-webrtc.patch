+    "Yu Gothic",
+    "Yu Gothic UI",
+};
+
+// True when no persona (or no font list) is set, or `family` is allowed.
+// Case-insensitive (ASCII); thread-safe; the set is built once per process.
+inline bool IsFontFamilyAllowed(std::string_view family) {
+  static const base::NoDestructor<std::optional<base::flat_set<std::string>>>
+      allowed([]() -> std::optional<base::flat_set<std::string>> {
+        const Persona* persona = GetPersona();
+        if (!persona || persona->fonts.empty()) {
+          return std::nullopt;
+        }
+        base::flat_set<std::string> set;
+        for (const auto& name : persona->fonts) {
+          set.insert(base::ToLowerASCII(name));
+        }
+        for (std::string_view name : kBaselineFonts) {
+          set.insert(base::ToLowerASCII(name));
+        }
+        return set;
+      }());
+  if (!allowed->has_value()) {
+    return true;
+  }
+  return (*allowed)->contains(base::ToLowerASCII(family));
+}
+
+// System font fallback: true when `family` is allowed by name, or a font a
+// default Windows install uses for fallback. Same conditions as above.
+inline bool IsFallbackFontAllowed(std::string_view family) {
+  if (IsFontFamilyAllowed(family)) {
+    return true;
+  }
+  for (std::string_view name : kWindowsFallbackFonts) {
+    if (base::EqualsCaseInsensitiveASCII(name, family)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace vanta
