+// Vanta (patch 0010): the font families pages may match by name.
+//
+// With a persona, a family is visible to pages only if it is in the persona's
+// Windows font list or in kBaselineFonts. kBaselineFonts are fonts every
+// Windows 10/11 install ships that Chromium itself names as defaults (generic
+// families, system-ui, emoji), so blocking them would break rendering and be
+// a tell of its own. System font fallback (glyphs a matched font lacks) may
+// pick a persona font or a font in kWindowsFallbackFonts (fonts a default
+// Windows 10/11 install ships for its scripts), never a font only this host
+// has installed: text in every script a default install covers still renders.
+//
+// Header-only so Blink (renderer) and content (Local Font Access, browser)
+// share one definition without a new GN target.
+inline constexpr std::string_view kBaselineFonts[] = {
+    "Arial",          "Comic Sans MS",   "Consolas",
+    "Courier New",    "Impact",          "Segoe UI",
+    "Segoe UI Emoji", "Segoe UI Symbol", "Times New Roman",
+};
+
+// Fonts a default Windows 10/11 install (no optional "supplemental fonts")
+// ships and DirectWrite's system font fallback picks for scripts, symbols
+// and emoji.
+inline constexpr std::string_view kWindowsFallbackFonts[] = {
+    "Arial",
+    "Calibri",
+    "Cambria",
+    "Cambria Math",
+    "Courier New",
+    "Ebrima",
+    "Gadugi",
