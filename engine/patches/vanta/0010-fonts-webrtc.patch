+// 1 +- 1.5e-6 from (seed, salt); 1 when the seed is 0.
+double MetricsFactor(uint64_t seed, uint64_t salt) {
+  if (!seed) {
+    return 1.0;
+  }
+  const double unit =
+      static_cast<double>(Mix64(seed ^ Mix64(salt)) >> 11) * 0x1.0p-53;
+  return 1.0 + (unit - 0.5) * 0.000003;
+}
