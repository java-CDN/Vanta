+// Vanta (patch 0010): the font families pages may match by name.
+//
+// With a persona, a family is visible to pages only if it is in the persona's
+// Windows font list or in kBaselineFonts. kBaselineFonts are fonts every
+// Windows 10/11 install ships that Chromium itself names as defaults (generic
+// families, system-ui, emoji), so blocking them would break rendering and be
+// a tell of its own. System font fallback (glyphs a matched font lacks) is not
+// filtered: text in any script still renders.
+//
+// Header-only so Blink (renderer) and content (Local Font Access, browser)
+// share one definition without a new GN target.
+inline constexpr std::string_view kBaselineFonts[] = {
+    "Arial",          "Comic Sans MS",   "Consolas",
+    "Courier New",    "Impact",          "Segoe UI",
+    "Segoe UI Emoji", "Segoe UI Symbol", "Times New Roman",
+};
+
+// True when no persona (or no font list) is set, or `family` is allowed.
+// Case-insensitive (ASCII); thread-safe; the set is built once per process.
+inline bool IsFontFamilyAllowed(std::string_view family) {
+  static const base::NoDestructor<std::optional<base::flat_set<std::string>>>
+      allowed([]() -> std::optional<base::flat_set<std::string>> {
+        const Persona* persona = GetPersona();
+        if (!persona || persona->fonts.empty()) {
+          return std::nullopt;
+        }
+        base::flat_set<std::string> set;
+        for (const auto& name : persona->fonts) {
+          set.insert(base::ToLowerASCII(name));
+        }
+        for (std::string_view name : kBaselineFonts) {
+          set.insert(base::ToLowerASCII(name));
+        }
+        return set;
+      }());
+  if (!allowed->has_value()) {
+    return true;
+  }
+  return (*allowed)->contains(base::ToLowerASCII(family));
+}
+
+}  // namespace vanta
+
+#endif  // COMPONENTS_VANTA_FONT_ALLOWLIST_H_
