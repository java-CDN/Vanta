+// Vanta (0010): a family matched by name (CSS font-family, local(),
+// document.fonts.check, canvas) is visible only if its real family name is
+// in the persona's Windows font list. Fallback and last-resort lookups go
+// to GetFontPlatformData directly and are not filtered.
+static bool VantaFontAllowed(const FontPlatformData* platform_data) {
+  if (!platform_data || !platform_data->Typeface()) {
+    return true;
+  }
+  SkString family;
+  platform_data->Typeface()->getFamilyName(&family);
+  return vanta_surfaces::IsFontFamilyAllowed(
+      std::string_view(family.c_str(), family.size()));
+}
