+          *show_state == ui::mojom::WindowShowState::kFullscreen) {
+        *show_state = ui::mojom::WindowShowState::kNormal;
+      }
+      bounds->set_width(std::min(bounds->width(), avail_width));
+      bounds->set_height(std::min(bounds->height(), avail_height));
+      bounds->set_x(std::clamp(bounds->x(), work_area.x(),
+                               work_area.x() + avail_width - bounds->width()));
+      bounds->set_y(std::clamp(bounds->y(), work_area.y(),
