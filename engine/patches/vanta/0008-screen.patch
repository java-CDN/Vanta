+// Vanta (0008): window.screenX/screenY (and screenLeft/screenTop) relative
+// to the persona screen: the window's offset from its own display's work
+// area, kept inside the persona's available area. The real desktop origin
+// (taskbar on the left/top, a second monitor to the left, negative
+// coordinates) never shows. nullopt: no persona, Chromium's own value.
+std::optional<int> VantaScreenPosition(ChromeClient& chrome_client,
+                                       LocalFrame& frame,
+                                       bool vertical) {
+  if (!vanta_surfaces::GetPersonaSurfaces()) {
+    return std::nullopt;
+  }
+  const gfx::Rect window = chrome_client.RootWindowRect(frame);
+  const gfx::Rect avail = chrome_client.GetScreenInfo(frame).available_rect;
+  const int offset = vertical ? window.y() - avail.y() : window.x() - avail.x();
+  const int room = vertical ? avail.height() - window.height()
+                            : avail.width() - window.width();
+  return std::clamp(offset, 0, std::max(0, room));
+}
