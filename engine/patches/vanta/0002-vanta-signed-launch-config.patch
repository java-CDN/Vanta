@@ -0,0 +1,122 @@
+// Copyright 2026 The Vanta Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/vanta/launch_config.h"
+
+#include <stdint.h>
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/version.h"
+#include "base/version_info/version_info.h"
+#include "third_party/boringssl/src/include/openssl/curve25519.h"
+
+namespace vanta {
+
+namespace {
+
+// A persona is a few KB; anything this large is not ours.
+constexpr size_t kMaxConfigBytes = 1024 * 1024;
+
+std::optional<base::DictValue>& PersonaSlot() {
+  static base::NoDestructor<std::optional<base::DictValue>> slot;
+  return *slot;
+}
+
+int Fail(int code, std::string_view why) {
+  LOG(ERROR) << "vanta: launch config rejected: " << why << " (exit " << code
+             << ")";
+  return code;
+}
+
+}  // namespace
+
+std::optional<int> VerifyLaunchConfig(const base::CommandLine& command_line) {
+  if (!command_line.HasSwitch(kVantaConfigSwitch)) {
+    return std::nullopt;
+  }
+
+  // 1. Read {"payload": ..., "signature": ...}.
+  const base::FilePath path =
+      command_line.GetSwitchValuePath(kVantaConfigSwitch);
+  std::string file;
+  if (path.empty() ||
+      !base::ReadFileToStringWithMaxSize(path, &file, kMaxConfigBytes)) {
+    return Fail(kExitBadConfigSignature, "config file unreadable");
+  }
+  std::optional<base::DictValue> outer =
+      base::JSONReader::ReadDict(file, base::JSON_PARSE_RFC);
+  if (!outer) {
+    return Fail(kExitBadConfigSignature, "config is not a JSON object");
+  }
+  const std::string* payload = outer->FindString("payload");
+  const std::string* signature_b64 = outer->FindString("signature");
+  if (!payload || !signature_b64) {
+    return Fail(kExitBadConfigSignature, "payload or signature missing");
+  }
+
+  // 2. Ed25519 over the exact payload bytes, as vanta-fingerprint signs them.
+  std::optional<std::vector<uint8_t>> signature =
+      base::Base64Decode(*signature_b64);
+  if (!signature || signature->size() != ED25519_SIGNATURE_LEN) {
+    return Fail(kExitBadConfigSignature, "signature is not 64 bytes base64");
+  }
+  std::optional<std::vector<uint8_t>> pubkey = base::Base64Decode(
+      command_line.GetSwitchValueASCII(kVantaPubkeySwitch));
+  if (!pubkey || pubkey->size() != ED25519_PUBLIC_KEY_LEN) {
+    return Fail(kExitBadConfigSignature,
+                "--vanta-pubkey missing or not 32 bytes base64");
+  }
+  if (ED25519_verify(reinterpret_cast<const uint8_t*>(payload->data()),
+                     payload->size(), signature->data(),
+                     pubkey->data()) != 1) {
+    return Fail(kExitBadConfigSignature, "bad signature");
+  }
+
+  // 3. Version lock (R5): the persona is bound to this engine's version.
+  std::optional<base::DictValue> persona =
+      base::JSONReader::ReadDict(*payload, base::JSON_PARSE_RFC);
+  if (!persona) {
+    return Fail(kExitBadConfigSignature, "payload is not a JSON object");
+  }
+  const base::DictValue* engine = persona->FindDict("engine");
+  if (!engine) {
+    return Fail(kExitBadConfigSignature, "payload has no engine version");
+  }
+  static constexpr const char* kParts[] = {"major", "minor", "build", "patch"};
+  std::vector<uint32_t> wanted;
+  for (const char* part : kParts) {
+    std::optional<int> v = engine->FindInt(part);
+    if (!v || *v < 0) {
+      return Fail(kExitBadConfigSignature, "engine version malformed");
+    }
+    wanted.push_back(static_cast<uint32_t>(*v));
+  }
+  const base::Version& own = version_info::GetVersion();
+  if (!own.IsValid() || own.components() != wanted) {
+    return Fail(kExitVersionMismatch,
+                "persona engine version differs from " + own.GetString());
+  }
+
+  PersonaSlot() = std::move(persona);
+  return std::nullopt;
+}
+
+const base::DictValue* GetVerifiedPersona() {
+  const std::optional<base::DictValue>& slot = PersonaSlot();
+  return slot ? &slot.value() : nullptr;
+}
+
+}  // namespace vanta
