+// Copyright 2026 The Vanta Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_VANTA_LAUNCH_CONFIG_H_
+#define CHROME_BROWSER_VANTA_LAUNCH_CONFIG_H_
+
+#include <optional>
+
+#include "base/values.h"
+
+namespace base {
+class CommandLine;
+}
+
+namespace vanta {
+
+// --vanta-config=<path>: file holding the signed launch config, the JSON form
+// of vanta-fingerprint's SignedConfig: {"payload": "<persona JSON>",
+// "signature": "<base64 Ed25519 signature over the payload bytes>"}.
+inline constexpr char kVantaConfigSwitch[] = "vanta-config";
+// --vanta-pubkey=<base64>: the 32-byte Ed25519 public key of the launcher.
+inline constexpr char kVantaPubkeySwitch[] = "vanta-pubkey";
+
+// Exit codes shared with the launcher (vanta-types exit_codes).
+inline constexpr int kExitBadConfigSignature = 86;
+inline constexpr int kExitVersionMismatch = 87;
+
+// Runs in the browser process before anything touches the profile. Without
+// --vanta-config it does nothing and returns std::nullopt. With it, the config
+// must carry a valid Ed25519 signature for --vanta-pubkey (else 86) and its
+// payload's engine version must equal this engine's own version (else 87).
+// Returns the exit code to stop with, or std::nullopt to continue.
+std::optional<int> VerifyLaunchConfig(const base::CommandLine& command_line);
+
+// The verified persona payload, or nullptr when no config was given.
+const base::DictValue* GetVerifiedPersona();
+
+}  // namespace vanta
+
+#endif  // CHROME_BROWSER_VANTA_LAUNCH_CONFIG_H_
