+// Vanta (0007): the persona's device memory, snapped to a value Chrome 156
+// itself can report on desktop: a power of two in [2, 32] GB (see the limits
+// in CalculateAndSetApproximatedDeviceMemory below).
+float VantaDeviceMemory(double gb) {
+  float value = 2.0f;
+  while (value < 32.0f && gb >= value * 1.5) {
+    value *= 2.0f;
+  }
+  return value;
+}
+
+}  // namespace
