+// Vanta (patch 0004): the persona's GPU when it is ANGLE Direct3D 11 at
+// feature level 11, as every Vanta device record is; else nullptr.
+const vanta_surfaces::PersonaSurfaces* VantaD3D11Gpu() {
+  const vanta_surfaces::PersonaSurfaces* p =
+      vanta_surfaces::GetPersonaSurfaces();
+  return p && p->gpu_d3d11_fl11 ? p : nullptr;
+}
+
+// ANGLE's D3D11 backend sets these from the feature level, not from the
+// driver (renderer11_utils.cpp), so they are the same on every such GPU;
+// only MAX_VERTEX_UNIFORM_VECTORS depends on the vendor (NVIDIA skips
+// register zero). Reporting them from the persona keeps them true to the
+// renderer string even when the host's own backend differs.
+std::optional<ScriptValue> VantaFixedParameter(ScriptState* script_state,
+                                               GLenum pname) {
+  const vanta_surfaces::PersonaSurfaces* gpu = VantaD3D11Gpu();
+  if (!gpu) {
+    return std::nullopt;
+  }
+  switch (pname) {
+    case GL_MAX_TEXTURE_SIZE:
+    case GL_MAX_CUBE_MAP_TEXTURE_SIZE:
+    case GL_MAX_RENDERBUFFER_SIZE:
+      return WebGLAny(script_state, 16384);
+    case GL_MAX_VERTEX_ATTRIBS:
+    case GL_MAX_TEXTURE_IMAGE_UNITS:
+    case GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS:
+      return WebGLAny(script_state, 16);
+    case GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS:
+      return WebGLAny(script_state, 32);
+    case GL_MAX_VARYING_VECTORS:
+      return WebGLAny(script_state, 30);
+    case GL_MAX_FRAGMENT_UNIFORM_VECTORS:
+      return WebGLAny(script_state, 1024);
+    case GL_MAX_VERTEX_UNIFORM_VECTORS:
+      return WebGLAny(script_state, gpu->gpu_nvidia ? 4095 : 4096);
+    case GL_MAX_VIEWPORT_DIMS: {
+      const std::array<GLint, 2> dims = {32767, 32767};
+      return WebGLAny(script_state, DOMInt32Array::Create(dims));
+    }
+    case GL_ALIASED_LINE_WIDTH_RANGE: {
+      const std::array<GLfloat, 2> range = {1.0f, 1.0f};
+      return WebGLAny(script_state, DOMFloat32Array::Create(range));
+    }
+    case GL_ALIASED_POINT_SIZE_RANGE: {
+      const std::array<GLfloat, 2> range = {1.0f, 1024.0f};
+      return WebGLAny(script_state, DOMFloat32Array::Create(range));
+    }
+    default:
+      return std::nullopt;
+  }
+}
