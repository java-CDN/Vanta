+// Copyright 2026 The Vanta Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/vanta/vanta_persona.h"
+
+#include <optional>
+#include <string_view>
+
+#include "base/no_destructor.h"
+#include "components/vanta/persona.h"
+
+namespace blink::vanta_surfaces {
+
+namespace {
+
+std::optional<PersonaSurfaces> Read() {
+  const ::vanta::Persona* persona = ::vanta::GetPersona();
+  if (!persona) {
+    return std::nullopt;
+  }
+  PersonaSurfaces s;
+  s.gpu_vendor = persona->webgl.vendor;
+  s.gpu_renderer = persona->webgl.renderer;
+  const std::string_view renderer = s.gpu_renderer;
+  s.gpu_d3d11_fl11 = renderer.starts_with("ANGLE (") &&
+                     renderer.find("Direct3D11 vs_5_0 ps_5_0") !=
+                         std::string_view::npos;
+  s.gpu_nvidia = renderer.starts_with("ANGLE (NVIDIA,");
+  using ::vanta::SurfaceMode;
+  if (persona->canvas_mode == SurfaceMode::kNoise) {
+    s.canvas_noise_seed = persona->seeds.canvas;
+  }
+  if (persona->webgl_image_mode == SurfaceMode::kNoise) {
+    s.webgl_image_noise_seed = persona->seeds.webgl;
+  }
+  if (persona->audio_mode == SurfaceMode::kNoise) {
+    s.audio_noise_seed = persona->seeds.audio;
+  }
+  s.canvas_block = persona->canvas_mode == SurfaceMode::kBlock;
+  s.webgl_image_block = persona->webgl_image_mode == SurfaceMode::kBlock;
+  s.audio_block = persona->audio_mode == SurfaceMode::kBlock;
+  return s;
+}
+
+}  // namespace
+
+const PersonaSurfaces* GetPersonaSurfaces() {
+  // Thread-safe one-time init; the persona never changes in a process.
+  static const base::NoDestructor<std::optional<PersonaSurfaces>> surfaces(
+      Read());
+  return surfaces->has_value() ? &surfaces->value() : nullptr;
+}
+
+}  // namespace blink::vanta_surfaces
