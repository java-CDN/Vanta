+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_VANTA_VANTA_PERSONA_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_VANTA_VANTA_PERSONA_H_
+
+#include <stdint.h>
+
+#include <string>
+
+#include "third_party/blink/renderer/platform/platform_export.h"
+
+namespace blink::vanta_surfaces {
+
+// What Blink reads from the verified Vanta persona (components/vanta), taken
+// once per process. This is the only file that touches the persona interface.
+struct PersonaSurfaces {
+  // WebGL (patch 0004). Empty strings: report the real GPU.
+  std::string gpu_vendor;    // UNMASKED_VENDOR_WEBGL
+  std::string gpu_renderer;  // UNMASKED_RENDERER_WEBGL
+  // The renderer is ANGLE Direct3D 11 at feature level 11 ("vs_5_0").
+  bool gpu_d3d11_fl11 = false;
+  // ANGLE names NVIDIA as the vendor ("ANGLE (NVIDIA, ...").
+  bool gpu_nvidia = false;
+  // Noise seeds; 0 unless the surface's mode is Noise.
+  uint64_t canvas_noise_seed = 0;      // patch 0005, Canvas 2D readback
+  uint64_t webgl_image_noise_seed = 0;  // patch 0005, WebGL readback
+  uint64_t audio_noise_seed = 0;       // patch 0006
+  // Mode Block: the surface's readback returns blank data (transparent
+  // black pixels, silent samples) instead of the rendered content.
+  bool canvas_block = false;
+  bool webgl_image_block = false;
+  bool audio_block = false;
+};
+
+// nullptr when the engine runs without a persona: Chromium behaves unchanged.
+// Safe to call from any thread.
+PLATFORM_EXPORT const PersonaSurfaces* GetPersonaSurfaces();
+
+// SplitMix64 finalizer: the one mixing function every Vanta noise uses, so
+// equal inputs give equal noise in every process and on every thread.
+inline uint64_t Mix64(uint64_t x) {
+  x += 0x9e3779b97f4a7c15ull;
+  x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ull;
+  x = (x ^ (x >> 27)) * 0x94d049bb133111ebull;
+  return x ^ (x >> 31);
+}
+
+}  // namespace blink::vanta_surfaces
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_VANTA_VANTA_PERSONA_H_
