# Vanta G5 (0006): seeded Web Audio readout noise (persona audio = Noise).
# OfflineAudioContext's rendered AudioBuffer is noised once, before the
# complete event / promise hands it to script, so getChannelData() and
# copyFromChannel() read the same stable data and buffers script fills itself
# are never touched. AnalyserNode float getters are noised on readout and the
# byte getters are the bytes of the noised floats (RealtimeAnalyser's own
# scaling), so float and byte reads agree. Realtime taps: ScriptProcessor
# input buffers (onaudioprocess) and AudioWorklet process() inputs. Lowest 3
# mantissa bits from (seed, stream, index, kept bits); zeros, infinities and
# round floats stay exact; idempotent. Mode Block: the same readouts return
# silence (samples 0, spectrum -Infinity dB, bytes of silence).
# Needs 0004 (platform/vanta/vanta_persona.h).

--- /dev/null
+++ b/third_party/blink/renderer/platform/vanta/audio_noise.h
@@ -0,0 +1,41 @@
