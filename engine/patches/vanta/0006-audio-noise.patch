+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_VANTA_AUDIO_NOISE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_VANTA_AUDIO_NOISE_H_
+
+#include <stdint.h>
+
+#include "base/containers/span.h"
+#include "third_party/blink/renderer/platform/platform_export.h"
+
+namespace blink::vanta_surfaces {
+
+// Seeded Web Audio readout noise (Vanta patch 0006), active only when the
+// persona's audio mode is Noise. Each sample keeps its sign, exponent and
+// top 20 mantissa bits; the lowest 3 mantissa bits (at most 7 ulp, about
+// 1e-6 relative, far below audibility and below any real analysis need)
+// come from (seed, stream, index, kept bits). Exact values stay exact:
+// zero/silence, infinities (-Infinity dB), NaN, and "round" floats whose
+// low 8 mantissa bits are zero (constant sources, gains). The kept bits
+// never change, so applying the noise twice equals applying it once.
+// Mode Block: every sample reads back as 0 (silence).
+PLATFORM_EXPORT void ApplyAudioNoise(base::span<float> samples,
+                                     uint64_t stream);
+
+// True when Web Audio readouts are changed (mode Noise or Block).
+PLATFORM_EXPORT bool AudioReadoutChanged();
+// True in mode Block.
+PLATFORM_EXPORT bool AudioBlocked();
+
+// Streams: AudioBuffer channels use their channel index.
+inline constexpr uint64_t kAnalyserFrequencyStream = 0x100;
+inline constexpr uint64_t kAnalyserTimeDomainStream = 0x101;
+// Realtime graph taps, plus the channel index.
+inline constexpr uint64_t kScriptProcessorInputStream = 0x200;
+inline constexpr uint64_t kAudioWorkletInputStream = 0x300;
+
+}  // namespace blink::vanta_surfaces
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_VANTA_AUDIO_NOISE_H_
