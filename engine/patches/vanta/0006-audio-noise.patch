 void AnalyserNode::getFloatFrequencyData(NotShared<DOMFloat32Array> array) {
   GetAnalyserHandler().GetFloatFrequencyData(array.Get(),
                                              context()->currentTime());
+  base::span<float> bins = array->AsSpan().first(
+      std::min<size_t>(array->length(), frequencyBinCount()));
+  if (vanta_surfaces::AudioBlocked()) {
+    // Silence in decibels.
+    std::ranges::fill(bins, -std::numeric_limits<float>::infinity());
+    return;
+  }
+  vanta_surfaces::ApplyAudioNoise(bins,
+                                  vanta_surfaces::kAnalyserFrequencyStream);
 }
 
 void AnalyserNode::getByteFrequencyData(NotShared<DOMUint8Array> array) {
-  GetAnalyserHandler().GetByteFrequencyData(array.Get(),
-                                            context()->currentTime());
+  if (!vanta_surfaces::AudioReadoutChanged()) {
+    GetAnalyserHandler().GetByteFrequencyData(array.Get(),
+                                              context()->currentTime());
+    return;
+  }
+  // Vanta (patch 0006): the bytes of the noised float spectrum, scaled as
+  // RealtimeAnalyser::GetByteFrequencyData does, so byte and float reads
+  // of the same frame agree.
+  const size_t len = std::min<size_t>(array->length(), frequencyBinCount());
+  NotShared<DOMFloat32Array> decibels(DOMFloat32Array::Create(len));
+  getFloatFrequencyData(decibels);
+  const double min_decibels = minDecibels();
+  const double max_decibels = maxDecibels();
+  const double range_scale_factor =
+      max_decibels == min_decibels ? 1.0 : 1.0 / (max_decibels - min_decibels);
+  base::span<const float> source = decibels->AsSpan();
+  base::span<uint8_t> destination = array->AsSpan();
+  for (size_t i = 0; i < len; ++i) {
+    const double scaled_value =
+        UCHAR_MAX * (source[i] - min_decibels) * range_scale_factor;
+    destination[i] =
+        static_cast<uint8_t>(ClampTo(scaled_value, 0, UCHAR_MAX));
+  }
 }
 
 void AnalyserNode::getFloatTimeDomainData(NotShared<DOMFloat32Array> array) {
   GetAnalyserHandler().GetFloatTimeDomainData(array.Get());
+  vanta_surfaces::ApplyAudioNoise(
+      array->AsSpan().first(std::min<size_t>(array->length(), fftSize())),
+      vanta_surfaces::kAnalyserTimeDomainStream);
 }
 
 void AnalyserNode::getByteTimeDomainData(NotShared<DOMUint8Array> array) {
-  GetAnalyserHandler().GetByteTimeDomainData(array.Get());
+  if (!vanta_surfaces::AudioReadoutChanged()) {
+    GetAnalyserHandler().GetByteTimeDomainData(array.Get());
+    return;
+  }
+  // Vanta (patch 0006): the bytes of the noised float samples, scaled as
+  // RealtimeAnalyser::GetByteTimeDomainData does.
+  const size_t len = std::min<size_t>(array->length(), fftSize());
+  NotShared<DOMFloat32Array> samples(DOMFloat32Array::Create(len));
+  getFloatTimeDomainData(samples);
+  base::span<const float> source = samples->AsSpan();
+  base::span<uint8_t> destination = array->AsSpan();
+  for (size_t i = 0; i < len; ++i) {
+    const double scaled_value = 128 * (source[i] + 1);
+    destination[i] =
+        static_cast<uint8_t>(ClampTo(scaled_value, 0, UCHAR_MAX));
+  }
 }
 
