# Vanta G7a (0009): per-profile time zone.
# The persona's IANA zone becomes the renderer's process-wide ICU default in
# TimeZoneController::Init (before any isolate or worker), so Date and Intl in
# windows and all workers agree; host time zone changes are ignored. Empty
# persona zone (no geo yet) keeps the host zone. No persona: unchanged.

--- a/third_party/blink/renderer/core/timezone/timezone_controller.cc
+++ b/third_party/blink/renderer/core/timezone/timezone_controller.cc
@@ -6,6 +6,7 @@
 
 #include "base/command_line.h"
 #include "base/feature_list.h"
+#include "base/logging.h"
 #include "mojo/public/cpp/bindings/pending_remote.h"
 #include "mojo/public/cpp/bindings/remote.h"
 #include "third_party/blink/public/common/features.h"
@@ -25,6 +26,7 @@
 #include "third_party/blink/renderer/platform/runtime_enabled_features.h"
 #include "third_party/blink/renderer/platform/scheduler/public/main_thread.h"
 #include "third_party/blink/renderer/platform/scheduler/public/main_thread_scheduler.h"
+#include "third_party/blink/renderer/platform/vanta/vanta_persona.h"
 #include "third_party/blink/renderer/platform/wtf/cross_thread_functional.h"
 #include "third_party/blink/renderer/platform/wtf/text/unicode_string.h"
 #include "third_party/blink/renderer/platform/wtf/wtf.h"
@@ -40,6 +42,29 @@
 // no later than January 2025.
 BASE_FEATURE(kLazyBlinkTimezoneInit, base::FEATURE_DISABLED_BY_DEFAULT);
 
+// Vanta (0009): set when the persona's IANA timezone is the renderer's ICU
+// default. The host zone is then never applied (OnTimeZoneChange).
+bool g_vanta_timezone_pinned = false;
+
+// Vanta (0009): make the persona timezone the process-wide ICU default. Runs
+// from TimeZoneController::Init(), i.e. CoreInitializer::Initialize() during
+// blink::Initialize(), before the main isolate or any worker exists, so
+// Date, Intl.DateTimeFormat and every realm in this renderer agree.
+void ApplyVantaTimeZone() {
+  const auto* vanta = vanta_surfaces::GetPersonaSurfaces();
+  if (!vanta || vanta->timezone.empty() || g_vanta_timezone_pinned) {
+    return;
+  }
+  std::unique_ptr<icu::TimeZone> timezone(icu::TimeZone::createTimeZone(
+      icu::UnicodeString::fromUTF8(vanta->timezone)));
+  if (!timezone || *timezone == icu::TimeZone::getUnknown()) {
+    LOG(ERROR) << "vanta: unknown persona timezone " << vanta->timezone;
+    return;
+  }
+  icu::TimeZone::adoptDefault(timezone.release());
+  g_vanta_timezone_pinned = true;
+}
+
 // Notify V8 that the date/time configuration of the system might have changed.
 void NotifyTimezoneChangeToV8(v8::Isolate* isolate) {
   DCHECK(isolate);
@@ -105,6 +130,8 @@
 
