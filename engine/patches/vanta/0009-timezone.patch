   DCHECK(IsMainThread());
 
+  // Vanta (0009): the persona zone stays; the PC's zone never leaks in.
+  if (g_vanta_timezone_pinned) {
+    return;
+  }
+
   base::AutoLock locker(instance().lock_);
 
   // Remember requested timezone id so we can set it when timezone
@@ -263,6 +318,13 @@
 
 const String& TimeZoneController::GetHostTimezoneId() {
   lock_.AssertAcquired();
+  // Vanta (0009): with a pinned persona zone, that zone is the "host" zone a
+  // cleared DevTools override returns to, never the ICU default of the
+  // moment (which may be the override itself under lazy init).
+  if (host_timezone_id_.IsNull() && g_vanta_timezone_pinned) {
+    host_timezone_id_ =
+        String::FromUtf8(base::as_byte_span(vanta_surfaces::GetPersonaSurfaces()->timezone));
+  }
   if (host_timezone_id_.IsNull()) {
     CHECK(base::FeatureList::IsEnabled(kLazyBlinkTimezoneInit));
     host_timezone_id_ = GetCurrentTimezoneId();
