+TEST(VantaPersonaTest, BrowserPersonaAndChildSwitch) {
+  ScopedBrowserPersonaReset reset;
+  // The test binary is a "browser" process: no persona until initialized.
+  EXPECT_EQ(GetPersona(), nullptr);
+
+  base::CommandLine untouched(base::CommandLine::NO_PROGRAM);
+  untouched.AppendSwitchASCII("type", "renderer");
+  AppendPersonaSwitch(&untouched);
+  EXPECT_FALSE(untouched.HasSwitch(kPersonaSwitch));
+
+  base::DictValue bad = PayloadDict();
+  bad.Set("webrtc_policy", "default");
+  EXPECT_FALSE(InitializeBrowserPersona(bad));
+  EXPECT_EQ(GetPersona(), nullptr);
+
+  ASSERT_TRUE(InitializeBrowserPersona(PayloadDict()));
+  const Persona* persona = GetPersona();
+  ASSERT_TRUE(persona);
+  EXPECT_EQ(*persona, *ParsePersonaJson(kPayload));
+  EXPECT_EQ(GetPersona(), persona);  // Stable pointer.
+
+  base::CommandLine child(base::CommandLine::NO_PROGRAM);
+  child.AppendSwitchASCII("type", "renderer");
+  AppendPersonaSwitch(&child);
+  AppendPersonaSwitch(&child);  // Idempotent.
+  EXPECT_EQ(child.argv().size(), 3u);  // program slot, --type, --vanta-persona
+  std::unique_ptr<Persona> from_child;
+  EXPECT_EQ(ReadPersonaSwitch(child, &from_child),
+            PersonaSwitchState::kValid);
+  ASSERT_TRUE(from_child);
+  EXPECT_EQ(*from_child, *persona);
+}
