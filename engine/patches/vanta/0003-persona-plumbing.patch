+// `payload` with the value at `path` replaced by the JSON `value`.
+std::unique_ptr<Persona> WithValue(std::string_view path,
+                                   std::string_view value) {
+  base::DictValue d = PayloadDict();
+  std::optional<base::Value> v =
+      base::JSONReader::Read(value, base::JSON_PARSE_RFC);
+  CHECK(v) << value;
+  d.SetByDottedPath(path, std::move(*v));
+  return PersonaFromDict(d);
+}
+
+std::unique_ptr<Persona> Without(std::string_view path) {
+  base::DictValue d = PayloadDict();
+  CHECK(d.RemoveByDottedPath(path)) << path;
+  return PersonaFromDict(d);
+}
