# Vanta 0003: persona plumbing (shared interface for patch groups G2-G8).
# New component //components/vanta (depends on //base only): vanta::Persona,
# vanta::GetPersona() (nullptr = no persona, plain Chromium). The browser
# process builds it from the payload 0002 has just verified (bad persona fields
# -> exit 86) and hands it to every child (renderer, GPU, utility/network) as
# --vanta-persona=<base64url of the canonical persona JSON>, appended in
# ChromeContentBrowserClient::AppendExtraCommandLineSwitches. Children parse it
# lazily; the browser never reads that switch. Unit tests in
# components_unittests (VantaPersonaTest.*). Interface: docs/persona-interface.md.

--- /dev/null
+++ b/components/vanta/BUILD.gn
@@ -0,0 +1,27 @@
+# Copyright 2026 The Vanta Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# Vanta persona (patch 0003): the verified launch persona as a C++ struct,
+# available in every process (browser, renderer, GPU, utility/network).
+# Depends on //base only, so Blink, content, services and chrome can all use
+# it. See docs/persona-interface.md in the Vanta repository.
+component("vanta") {
+  sources = [
+    "persona.cc",
+    "persona.h",
+  ]
+  defines = [ "IS_VANTA_IMPL" ]
+  deps = [ "//base" ]
+}
+
+source_set("unit_tests") {
+  testonly = true
+  sources = [ "persona_unittest.cc" ]
+  deps = [
+    ":vanta",
+    "//base",
+    "//base/test:test_support",
+    "//testing/gtest",
+  ]
+}
