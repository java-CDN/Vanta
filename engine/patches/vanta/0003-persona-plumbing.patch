+// Copyright 2026 The Vanta Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_VANTA_PERSONA_H_
+#define COMPONENTS_VANTA_PERSONA_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/component_export.h"
+
+namespace base {
+class CommandLine;
+class DictValue;
+}  // namespace base
+
+// The Vanta persona: the fingerprint one profile presents, as signed by the
+// Vanta launcher (vanta-fingerprint `LaunchPayload`) and verified by the
+// browser process (chrome/browser/vanta/launch_config.cc, patch 0002).
+//
+// Every process reads it with vanta::GetPersona(). A null result means the
+// engine was started without --vanta-config and must behave exactly like plain
+// Chromium. The persona never changes during the life of a process.
+//
+// JSON names in the comments are the keys of the signed payload; the full
+// mapping is in docs/persona-interface.md.
+namespace vanta {
+
+// Switch the browser appends to every child process it launches: base64url
+// (RFC 4648 section 5, no padding) of the canonical persona JSON.
+inline constexpr char kPersonaSwitch[] = "vanta-persona";
+
+// Upper bound for the --vanta-persona value. The browser refuses a persona
+// that would exceed it (exit 86) and children reject a longer value. Windows
+// limits a whole command line to 32767 characters.
+inline constexpr size_t kMaxPersonaSwitchValueLength = 16 * 1024;
+
+// The only persona schema this engine understands ("schema").
+inline constexpr int kPersonaSchema = 1;
+
+// The only WebRTC IP handling policy a persona may carry ("webrtc_policy").
+// It is Chromium's own pref value (blink::kWebRTCIPHandlingDisableNonProxiedUdp).
+inline constexpr char kWebRtcPolicyDisableNonProxiedUdp[] =
+    "disable_non_proxied_udp";
+
+// "os": "windows10" | "windows11". Vanta personas are Windows only (R1).
+enum class WindowsRelease {
+  kWindows10,
+  kWindows11,
+};
+
+// "canvas", "webgl_image", "audio": "real" | "noise" | "block".
+enum class SurfaceMode {
+  kReal,   // Values from the host as plain Chromium computes them.
+  kNoise,  // Small, stable per-profile perturbation from the matching seed.
+  kBlock,  // The API reports itself unavailable.
+};
+
+// One entry of "ua_ch.brands" / "ua_ch.full_version_list": ["brand", "ver"].
+struct COMPONENT_EXPORT(VANTA) BrandVersion {
+  std::string brand;
+  std::string version;
+
+  bool operator==(const BrandVersion&) const = default;
+};
+
+// "ua_ch": User-Agent Client Hints, exactly as navigator.userAgentData and
+// the Sec-CH-UA-* headers must report them.
+struct COMPONENT_EXPORT(VANTA) UaClientHints {
+  UaClientHints();
+  UaClientHints(const UaClientHints&);
+  UaClientHints& operator=(const UaClientHints&);
+  UaClientHints(UaClientHints&&);
+  UaClientHints& operator=(UaClientHints&&);
+  ~UaClientHints();
+  bool operator==(const UaClientHints&) const;
+
+  std::vector<BrandVersion> brands;             // "brands" (non-empty)
+  std::vector<BrandVersion> full_version_list;  // "full_version_list"
+  std::string platform;                         // "platform", always "Windows"
+  std::string platform_version;                 // "platform_version", "10.0.0"
+  std::string architecture;                     // "architecture", "x86"
+  std::string bitness;                          // "bitness", "64"
+  std::string model;                            // "model", may be empty
+  bool mobile = false;                          // "mobile", always false
+  bool wow64 = false;                           // "wow64"
+  std::vector<std::string> form_factors;        // "form_factors"
+};
+
+// "screen" plus the top-level "device_pixel_ratio".
+struct COMPONENT_EXPORT(VANTA) Screen {
+  int width = 0;                    // "screen.width" (CSS px)
+  int height = 0;                   // "screen.height"
+  int avail_width = 0;              // "screen.avail_width" (<= width)
+  int avail_height = 0;             // "screen.avail_height" (<= height)
+  int color_depth = 0;              // "screen.color_depth" (= pixelDepth)
+  double device_pixel_ratio = 1.0;  // top-level "device_pixel_ratio"
+
+  bool operator==(const Screen&) const = default;
+};
+
+// "gpu.vendor" / "gpu.renderer": UNMASKED_VENDOR_WEBGL / UNMASKED_RENDERER_WEBGL.
+// The device records carry no other WebGL parameters; limits follow from the
+// renderer string (see docs/persona-interface.md).
+struct COMPONENT_EXPORT(VANTA) WebGl {
+  std::string vendor;    // "gpu.vendor", e.g. "Google Inc. (NVIDIA)"
+  std::string renderer;  // "gpu.renderer", e.g. "ANGLE (NVIDIA, ...)"
+
+  bool operator==(const WebGl&) const = default;
+};
+
+// GPUAdapterInfo for WebGPU.
+struct COMPONENT_EXPORT(VANTA) WebGpu {
+  std::string vendor;        // "gpu.webgpu_vendor", e.g. "nvidia"
+  std::string architecture;  // "gpu.webgpu_arch", e.g. "ampere"
+
+  bool operator==(const WebGpu&) const = default;
+};
+
+// Per-surface noise seeds, all non-zero. Derived by the launcher from the
+// profile seed; the engine never invents randomness. JSON carries them as
+// decimal strings because base::JSONReader would round a u64 number.
+struct COMPONENT_EXPORT(VANTA) Seeds {
+  uint64_t canvas = 0;        // "canvas_seed"
+  uint64_t audio = 0;         // "audio_seed"
+  uint64_t webgl = 0;         // "webgl_seed"
+  uint64_t font = 0;          // "font_seed"
+  uint64_t client_rects = 0;  // "clientrects_seed"
+
+  bool operator==(const Seeds&) const = default;
+};
+
+// "media_devices": how many devices of each kind enumerateDevices() lists.
+struct COMPONENT_EXPORT(VANTA) MediaDeviceCounts {
+  int audio_input = 0;   // "audioinput"
+  int audio_output = 0;  // "audiooutput"
+  int video_input = 0;   // "videoinput"
+
+  bool operator==(const MediaDeviceCounts&) const = default;
+};
+
+// "geo" (null until the launcher knows the exit IP's location). Its
+// "timezone" is Persona::timezone.
+struct COMPONENT_EXPORT(VANTA) Geolocation {
+  std::string country;    // "geo.country", ISO 3166-1 alpha-2
+  double latitude = 0;    // "geo.latitude", [-90, 90]
+  double longitude = 0;   // "geo.longitude", [-180, 180]
+  int accuracy_m = 0;     // "geo.accuracy_m", >= 0
+
+  bool operator==(const Geolocation&) const = default;
+};
+
+struct COMPONENT_EXPORT(VANTA) Persona {
+  Persona();
+  Persona(const Persona&);
+  Persona& operator=(const Persona&);
+  Persona(Persona&&);
+  Persona& operator=(Persona&&);
+  ~Persona();
+  bool operator==(const Persona&) const;
+
+  int schema = kPersonaSchema;                     // "schema"
+  WindowsRelease os = WindowsRelease::kWindows10;  // "os"
+
+  // G2: navigator, User-Agent, UA-CH.
+  std::string user_agent;  // "user_agent" (User-Agent header + navigator)
+  std::string brand;       // "brand", e.g. "Google Chrome"
+  std::string platform;    // "platform" (navigator.platform), always "Win32"
+  UaClientHints ua_ch;     // "ua_ch"
+
+  // G3: hardware and screen.
+  int hardware_concurrency = 0;  // "hardware_concurrency", [1, 1024]
+  double device_memory_gb = 0;   // "device_memory" (GiB, unrounded)
+  int max_touch_points = 0;      // "max_touch_points"
+  Screen screen;                 // "screen" + "device_pixel_ratio"
+
+  // G4/G5: canvas, WebGL, WebGPU, audio.
+  WebGl webgl;                                   // "gpu.vendor/renderer"
+  WebGpu webgpu;                                 // "gpu.webgpu_*"
+  SurfaceMode canvas_mode = SurfaceMode::kReal;  // "canvas"
+  SurfaceMode webgl_image_mode = SurfaceMode::kReal;  // "webgl_image"
+  SurfaceMode audio_mode = SurfaceMode::kReal;   // "audio"
+  Seeds seeds;
+
+  // G6: fonts. The allow-list of font family names the page may see
+  // ("fonts", non-empty).
+  std::vector<std::string> fonts;
+
+  // G7: time zone, locale, languages, geolocation, media devices.
+  // IANA zone ("geo.timezone"), e.g. "Europe/Berlin". Empty while the
+  // persona has no "geo"; G7 decides what that means (see the interface doc).
+  std::string timezone;
+  std::string locale;                   // "locale", e.g. "de-DE"
+  std::vector<std::string> languages;   // "languages" (navigator.languages)
+  std::string accept_language;          // "accept_language" (header value)
+  std::optional<Geolocation> geolocation;  // "geo"
+  MediaDeviceCounts media_devices;      // "media_devices"
+
+  // G8: always kWebRtcPolicyDisableNonProxiedUdp ("webrtc_policy").
+  std::string webrtc_policy;
+};
+
+// The persona of this process, or nullptr when the engine runs without one.
+//
+// Browser process: the persona verified from --vanta-config, set once by
+// InitializeBrowserPersona() during ChromeMainDelegate::BasicStartupComplete,
+// before any other thread or child process exists. The browser never reads
+// --vanta-persona, so the switch cannot bypass the signature there.
+//
+// Child processes (any --type): parsed on first call from --vanta-persona.
+// No switch -> nullptr. A switch that is present but malformed crashes the
+// process (CHECK): it can only come from corruption, and running on with the
+// host's real fingerprint would be a leak.
+//
+// Thread-safe, cheap after the first call, and the pointer stays valid for
+// the life of the process.
+COMPONENT_EXPORT(VANTA) const Persona* GetPersona();
+
+// ---- Browser process only -------------------------------------------------
+
+// Builds the persona from the signed payload that launch_config.cc has just
+// verified, and prepares the --vanta-persona value. Returns false (the caller
+// exits 86) when a field is missing or invalid, or when the encoded persona
+// exceeds kMaxPersonaSwitchValueLength. Call at most once.
+COMPONENT_EXPORT(VANTA)
+bool InitializeBrowserPersona(const base::DictValue& verified_payload);
+
+// Appends --vanta-persona to a child process command line when the browser
+// has a persona; otherwise, or when the switch is already there, does
+// nothing. Called from ChromeContentBrowserClient::AppendExtraCommandLineSwitches,
+// which content runs for renderer, GPU and utility (network service, audio,
+// storage, ...) launches.
+COMPONENT_EXPORT(VANTA) void AppendPersonaSwitch(base::CommandLine* child);
+
+// ---- Parsing and encoding (pure functions; also used by the tests) --------
+
+// The persona fields of a payload object. Unknown keys (engine, seed,
+// device_id, vanta_launch, ...) are ignored. Returns nullptr when any field
+// is missing, has the wrong JSON type or is out of range.
+COMPONENT_EXPORT(VANTA)
+std::unique_ptr<Persona> PersonaFromDict(const base::DictValue& payload);
+
+// Same for a JSON text (RFC 8259). nullptr on any error.
+COMPONENT_EXPORT(VANTA)
+std::unique_ptr<Persona> ParsePersonaJson(std::string_view json);
+
+// Canonical JSON of `persona`: the payload's own key names, keys sorted,
+// only the fields above. PersonaFromDict/ParsePersonaJson read it back to an
+// equal Persona.
+COMPONENT_EXPORT(VANTA) std::string SerializePersona(const Persona& persona);
+
+// base64url (no padding) of SerializePersona(): the --vanta-persona value.
+COMPONENT_EXPORT(VANTA)
+std::string EncodePersonaSwitchValue(const Persona& persona);
+
+// Inverse of EncodePersonaSwitchValue(). nullptr when the value is longer
+// than kMaxPersonaSwitchValueLength, not unpadded base64url, or not a valid
+// persona.
+COMPONENT_EXPORT(VANTA)
+std::unique_ptr<Persona> DecodePersonaSwitchValue(std::string_view value);
+
+// What a process command line says about the persona. GetPersona() uses it
+// for child processes.
+enum class PersonaSwitchState {
+  kAbsent,     // Browser process (no --type), or no --vanta-persona.
+  kValid,      // Child process with a valid --vanta-persona.
+  kMalformed,  // Child process with an unusable --vanta-persona.
+};
+COMPONENT_EXPORT(VANTA)
+PersonaSwitchState ReadPersonaSwitch(const base::CommandLine& command_line,
+                                     std::unique_ptr<Persona>* persona);
+
+// Testing only: forgets the browser persona so a test can initialize again.
+// Has no effect on a child process persona already parsed by GetPersona().
+COMPONENT_EXPORT(VANTA) void ResetBrowserPersonaForTesting();
+
+}  // namespace vanta
+
+#endif  // COMPONENTS_VANTA_PERSONA_H_
