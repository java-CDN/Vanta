+TEST(VantaPersonaTest, ParsesLaunchPayload) {
+  std::unique_ptr<Persona> p = ParsePersonaJson(kPayload);
+  ASSERT_TRUE(p);
+  EXPECT_EQ(p->schema, 1);
+  EXPECT_EQ(p->os, WindowsRelease::kWindows10);
+  EXPECT_EQ(p->user_agent,
