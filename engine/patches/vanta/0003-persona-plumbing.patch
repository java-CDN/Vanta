+TEST(VantaPersonaTest, NoGeoMeansNoTimezone) {
+  std::unique_ptr<Persona> p = ParsePersonaJson(kPayloadNoGeo);
+  ASSERT_TRUE(p);
+  EXPECT_FALSE(p->geolocation);
+  EXPECT_EQ(p->timezone, "");
+  EXPECT_EQ(p->locale, "en-US");
+  EXPECT_EQ(p->accept_language, "en-US,en;q=0.9");
