+TEST(VantaPersonaTest, MalformedJsonIsNull) {
+  for (const char* json :
+       {"", " ", "null", "[]", "1", "\"x\"", "{", "{}", "{\"schema\":1}",
+        "{\"schema\":1,} ", "// comment\n{}"}) {
+    EXPECT_FALSE(ParsePersonaJson(json)) << json;
+  }
+  // Truncated payload.
+  const std::string half(kPayload, sizeof(kPayload) / 2);
+  EXPECT_FALSE(ParsePersonaJson(half));
+  // Chromium JSON extensions are not accepted (RFC mode).
+  std::string trailing_comma(kPayload);
+  trailing_comma.insert(trailing_comma.size() - 1, ",");
+  EXPECT_FALSE(ParsePersonaJson(trailing_comma));
+}
