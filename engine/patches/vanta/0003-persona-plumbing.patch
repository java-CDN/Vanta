@@ -0,0 +1,608 @@
+// Copyright 2026 The Vanta Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/vanta/persona.h"
+
+#include <atomic>
+#include <cmath>
+#include <iterator>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/base64url.h"
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+
+namespace vanta {
+
+namespace {
+
+// content::switches::kProcessType. Spelled out because this component must
+// not depend on //content (Blink and services use it too).
+constexpr char kProcessTypeSwitch[] = "type";
+
+// Generous bounds: they only keep garbage out, the launcher's rules
+// (vanta-fingerprint C001-C030) decide what is plausible.
+constexpr size_t kMaxStringLength = 2048;
+constexpr size_t kMaxListLength = 4096;
+
+const char* const kSurfaceModeNames[] = {"real", "noise", "block"};
+
+// ---- Readers: each returns false when the key is missing or invalid -------
+
+// No control characters: several values end up in HTTP headers.
+bool IsCleanString(std::string_view s) {
+  if (s.size() > kMaxStringLength) {
+    return false;
+  }
+  for (char c : s) {
+    const unsigned char u = static_cast<unsigned char>(c);
+    if (u < 0x20 || u == 0x7f) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool ReadString(const base::DictValue& d,
+                std::string_view key,
+                bool allow_empty,
+                std::string* out) {
+  const std::string* v = d.FindString(key);
+  if (!v || (!allow_empty && v->empty()) || !IsCleanString(*v)) {
+    return false;
+  }
+  *out = *v;
+  return true;
+}
+
+bool ReadInt(const base::DictValue& d,
+             std::string_view key,
+             int min,
+             int max,
+             int* out) {
+  std::optional<int> v = d.FindInt(key);
+  if (!v || *v < min || *v > max) {
+    return false;
+  }
+  *out = *v;
+  return true;
+}
+
+// Accepts JSON integers too (serde writes 8.0, a hand-written payload 8).
+bool ReadDouble(const base::DictValue& d,
+                std::string_view key,
+                double min,
+                double max,
+                double* out) {
+  std::optional<double> v = d.FindDouble(key);
+  if (!v || !std::isfinite(*v) || *v < min || *v > max) {
+    return false;
+  }
+  *out = *v;
+  return true;
+}
+
+bool ReadBool(const base::DictValue& d, std::string_view key, bool* out) {
+  std::optional<bool> v = d.FindBool(key);
+  if (!v) {
+    return false;
+  }
+  *out = *v;
+  return true;
+}
+
+bool ReadStringList(const base::DictValue& d,
+                    std::string_view key,
+                    bool allow_empty_list,
+                    std::vector<std::string>* out) {
+  const base::ListValue* list = d.FindList(key);
+  if (!list || list->size() > kMaxListLength ||
+      (!allow_empty_list && list->empty())) {
+    return false;
+  }
+  std::vector<std::string> result;
+  result.reserve(list->size());
+  for (const base::Value& item : *list) {
+    const std::string* s = item.GetIfString();
+    if (!s || s->empty() || !IsCleanString(*s)) {
+      return false;
+    }
+    result.push_back(*s);
+  }
+  *out = std::move(result);
+  return true;
+}
+
+// [["Chromium", "156"], ...], serde's form of Vec<(String, String)>.
+bool ReadBrandList(const base::DictValue& d,
+                   std::string_view key,
+                   std::vector<BrandVersion>* out) {
+  const base::ListValue* list = d.FindList(key);
+  if (!list || list->empty() || list->size() > kMaxListLength) {
+    return false;
+  }
+  std::vector<BrandVersion> result;
+  result.reserve(list->size());
+  for (const base::Value& item : *list) {
+    const base::ListValue* pair = item.GetIfList();
+    if (!pair || pair->size() != 2) {
+      return false;
+    }
+    const std::string* brand = (*pair)[0].GetIfString();
+    const std::string* version = (*pair)[1].GetIfString();
+    if (!brand || !version || brand->empty() || version->empty() ||
+        !IsCleanString(*brand) || !IsCleanString(*version)) {
+      return false;
+    }
+    result.push_back({*brand, *version});
+  }
+  *out = std::move(result);
+  return true;
+}
+
+// Decimal digits only, 1..2^64-1.
+bool ReadSeed(const base::DictValue& d, std::string_view key, uint64_t* out) {
+  const std::string* s = d.FindString(key);
+  if (!s || s->empty() || s->size() > 20) {
+    return false;
+  }
+  for (char c : *s) {
+    if (c < '0' || c > '9') {
+      return false;
+    }
+  }
+  uint64_t v = 0;
+  if (!base::StringToUint64(*s, &v) || v == 0) {
+    return false;
+  }
+  *out = v;
+  return true;
+}
+
+bool ReadSurfaceMode(const base::DictValue& d,
+                     std::string_view key,
+                     SurfaceMode* out) {
+  const std::string* s = d.FindString(key);
+  if (!s) {
+    return false;
+  }
+  static constexpr SurfaceMode kModes[] = {
+      SurfaceMode::kReal, SurfaceMode::kNoise, SurfaceMode::kBlock};
+  for (size_t i = 0; i < std::size(kModes); ++i) {
+    if (*s == kSurfaceModeNames[i]) {
+      *out = kModes[i];
+      return true;
+    }
+  }
+  return false;
+}
+
+const char* SurfaceModeName(SurfaceMode mode) {
+  return kSurfaceModeNames[static_cast<size_t>(mode)];
+}
+
+const char* WindowsReleaseName(WindowsRelease os) {
+  return os == WindowsRelease::kWindows11 ? "windows11" : "windows10";
+}
+
+// A language tag as navigator.languages lists it: no separators the
+// Accept-Language syntax uses.
+bool IsLanguageTag(std::string_view tag) {
+  for (char c : tag) {
+    const bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                    (c >= '0' && c <= '9') || c == '-';
+    if (!ok) {
+      return false;
+    }
+  }
+  return !tag.empty();
+}
+
+bool ReadUaClientHints(const base::DictValue& d, UaClientHints* out) {
+  UaClientHints ch;
+  if (!ReadBrandList(d, "brands", &ch.brands) ||
+      !ReadBrandList(d, "full_version_list", &ch.full_version_list) ||
+      !ReadString(d, "platform", false, &ch.platform) ||
+      !ReadString(d, "platform_version", false, &ch.platform_version) ||
+      !ReadString(d, "architecture", false, &ch.architecture) ||
+      !ReadString(d, "bitness", false, &ch.bitness) ||
+      !ReadString(d, "model", true, &ch.model) ||
+      !ReadBool(d, "mobile", &ch.mobile) ||
+      !ReadBool(d, "wow64", &ch.wow64) ||
+      !ReadStringList(d, "form_factors", true, &ch.form_factors)) {
+    return false;
+  }
+  // R1: Windows desktop personas only.
+  if (ch.platform != "Windows" || ch.mobile) {
+    return false;
+  }
+  *out = std::move(ch);
+  return true;
+}
+
+bool ReadScreen(const base::DictValue& payload, Screen* out) {
+  const base::DictValue* d = payload.FindDict("screen");
+  if (!d) {
+    return false;
+  }
+  Screen s;
+  if (!ReadInt(*d, "width", 1, 65535, &s.width) ||
+      !ReadInt(*d, "height", 1, 65535, &s.height) ||
+      !ReadInt(*d, "avail_width", 1, s.width, &s.avail_width) ||
+      !ReadInt(*d, "avail_height", 1, s.height, &s.avail_height) ||
+      !ReadInt(*d, "color_depth", 1, 64, &s.color_depth) ||
+      !ReadDouble(payload, "device_pixel_ratio", 0.1, 16.0,
+                  &s.device_pixel_ratio)) {
+    return false;
+  }
+  *out = s;
+  return true;
+}
+
+// "geo": absent or null -> no location and no time zone.
+bool ReadGeo(const base::DictValue& payload,
+             std::optional<Geolocation>* geo,
+             std::string* timezone) {
+  const base::Value* v = payload.Find("geo");
+  if (!v || v->is_none()) {
+    geo->reset();
+    timezone->clear();
+    return true;
+  }
+  const base::DictValue* d = v->GetIfDict();
+  if (!d) {
+    return false;
+  }
+  Geolocation g;
+  std::string tz;
+  if (!ReadString(*d, "country", true, &g.country) ||
+      !ReadString(*d, "timezone", false, &tz) ||
+      !ReadDouble(*d, "latitude", -90.0, 90.0, &g.latitude) ||
+      !ReadDouble(*d, "longitude", -180.0, 180.0, &g.longitude) ||
+      !ReadInt(*d, "accuracy_m", 0, 40'000'000, &g.accuracy_m)) {
+    return false;
+  }
+  *geo = std::move(g);
+  *timezone = std::move(tz);
+  return true;
+}
+
+base::ListValue StringList(const std::vector<std::string>& items) {
+  base::ListValue list;
+  for (const std::string& s : items) {
+    list.Append(s);
+  }
+  return list;
+}
+
+base::ListValue BrandList(const std::vector<BrandVersion>& items) {
+  base::ListValue list;
+  for (const BrandVersion& b : items) {
+    list.Append(base::ListValue().Append(b.brand).Append(b.version));
+  }
+  return list;
+}
