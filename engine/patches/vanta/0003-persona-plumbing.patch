+std::unique_ptr<Persona> PersonaFromDict(const base::DictValue& d) {
+  auto p = std::make_unique<Persona>();
+
+  if (!ReadInt(d, "schema", kPersonaSchema, kPersonaSchema, &p->schema)) {
+    return nullptr;
+  }
+  std::string os;
+  if (!ReadString(d, "os", false, &os)) {
+    return nullptr;
+  }
+  if (os == "windows10") {
+    p->os = WindowsRelease::kWindows10;
+  } else if (os == "windows11") {
+    p->os = WindowsRelease::kWindows11;
+  } else {
+    return nullptr;
+  }
+
+  // G2.
+  const base::DictValue* ua_ch = d.FindDict("ua_ch");
+  if (!ReadString(d, "user_agent", false, &p->user_agent) ||
+      !ReadString(d, "brand", false, &p->brand) ||
+      !ReadString(d, "platform", false, &p->platform) ||
+      p->platform != "Win32" || !ua_ch ||
+      !ReadUaClientHints(*ua_ch, &p->ua_ch)) {
+    return nullptr;
+  }
+
+  // G3.
+  if (!ReadInt(d, "hardware_concurrency", 1, 1024,
+               &p->hardware_concurrency) ||
+      !ReadDouble(d, "device_memory", 0.125, 4096.0, &p->device_memory_gb) ||
+      !ReadInt(d, "max_touch_points", 0, 256, &p->max_touch_points) ||
+      !ReadScreen(d, &p->screen)) {
+    return nullptr;
+  }
+
+  // G4/G5.
+  const base::DictValue* gpu = d.FindDict("gpu");
+  if (!gpu || !ReadString(*gpu, "vendor", false, &p->webgl.vendor) ||
+      !ReadString(*gpu, "renderer", false, &p->webgl.renderer) ||
+      !ReadString(*gpu, "webgpu_vendor", true, &p->webgpu.vendor) ||
+      !ReadString(*gpu, "webgpu_arch", true, &p->webgpu.architecture) ||
+      !ReadSurfaceMode(d, "canvas", &p->canvas_mode) ||
+      !ReadSurfaceMode(d, "webgl_image", &p->webgl_image_mode) ||
+      !ReadSurfaceMode(d, "audio", &p->audio_mode) ||
+      !ReadSeed(d, "canvas_seed", &p->seeds.canvas) ||
+      !ReadSeed(d, "audio_seed", &p->seeds.audio) ||
+      !ReadSeed(d, "webgl_seed", &p->seeds.webgl) ||
+      !ReadSeed(d, "font_seed", &p->seeds.font) ||
+      !ReadSeed(d, "clientrects_seed", &p->seeds.client_rects)) {
+    return nullptr;
+  }
+
+  // G6.
+  if (!ReadStringList(d, "fonts", false, &p->fonts)) {
+    return nullptr;
+  }
+
+  // G7.
+  const base::DictValue* media = d.FindDict("media_devices");
+  if (!ReadString(d, "locale", false, &p->locale) ||
+      !IsLanguageTag(p->locale) ||
+      !ReadStringList(d, "languages", false, &p->languages) ||
+      !ReadString(d, "accept_language", false, &p->accept_language) ||
+      !ReadGeo(d, &p->geolocation, &p->timezone) || !media ||
+      !ReadInt(*media, "audioinput", 0, 64, &p->media_devices.audio_input) ||
+      !ReadInt(*media, "audiooutput", 0, 64,
+               &p->media_devices.audio_output) ||
+      !ReadInt(*media, "videoinput", 0, 64, &p->media_devices.video_input)) {
+    return nullptr;
+  }
+  for (const std::string& language : p->languages) {
+    if (!IsLanguageTag(language)) {
+      return nullptr;
+    }
+  }
+
+  // G8.
+  if (!ReadString(d, "webrtc_policy", false, &p->webrtc_policy) ||
+      p->webrtc_policy != kWebRtcPolicyDisableNonProxiedUdp) {
+    return nullptr;
+  }
+
+  return p;
+}
+
+std::unique_ptr<Persona> ParsePersonaJson(std::string_view json) {
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return nullptr;
+  }
+  return PersonaFromDict(*dict);
+}
+
+std::string SerializePersona(const Persona& p) {
+  base::DictValue ua_ch;
+  ua_ch.Set("brands", BrandList(p.ua_ch.brands));
+  ua_ch.Set("full_version_list", BrandList(p.ua_ch.full_version_list));
+  ua_ch.Set("platform", p.ua_ch.platform);
+  ua_ch.Set("platform_version", p.ua_ch.platform_version);
+  ua_ch.Set("architecture", p.ua_ch.architecture);
+  ua_ch.Set("bitness", p.ua_ch.bitness);
+  ua_ch.Set("model", p.ua_ch.model);
+  ua_ch.Set("mobile", p.ua_ch.mobile);
+  ua_ch.Set("wow64", p.ua_ch.wow64);
+  ua_ch.Set("form_factors", StringList(p.ua_ch.form_factors));
+
+  base::DictValue screen;
+  screen.Set("width", p.screen.width);
+  screen.Set("height", p.screen.height);
+  screen.Set("avail_width", p.screen.avail_width);
+  screen.Set("avail_height", p.screen.avail_height);
+  screen.Set("color_depth", p.screen.color_depth);
+
+  base::DictValue gpu;
+  gpu.Set("vendor", p.webgl.vendor);
+  gpu.Set("renderer", p.webgl.renderer);
+  gpu.Set("webgpu_vendor", p.webgpu.vendor);
+  gpu.Set("webgpu_arch", p.webgpu.architecture);
+
+  base::DictValue media;
+  media.Set("audioinput", p.media_devices.audio_input);
+  media.Set("audiooutput", p.media_devices.audio_output);
+  media.Set("videoinput", p.media_devices.video_input);
+
+  base::DictValue d;
+  d.Set("schema", p.schema);
+  d.Set("os", WindowsReleaseName(p.os));
+  d.Set("user_agent", p.user_agent);
+  d.Set("brand", p.brand);
+  d.Set("platform", p.platform);
+  d.Set("ua_ch", std::move(ua_ch));
+  d.Set("hardware_concurrency", p.hardware_concurrency);
+  d.Set("device_memory", p.device_memory_gb);
+  d.Set("max_touch_points", p.max_touch_points);
+  d.Set("screen", std::move(screen));
+  d.Set("device_pixel_ratio", p.screen.device_pixel_ratio);
+  d.Set("gpu", std::move(gpu));
+  d.Set("canvas", SurfaceModeName(p.canvas_mode));
+  d.Set("webgl_image", SurfaceModeName(p.webgl_image_mode));
+  d.Set("audio", SurfaceModeName(p.audio_mode));
+  d.Set("canvas_seed", base::NumberToString(p.seeds.canvas));
+  d.Set("audio_seed", base::NumberToString(p.seeds.audio));
+  d.Set("webgl_seed", base::NumberToString(p.seeds.webgl));
+  d.Set("font_seed", base::NumberToString(p.seeds.font));
+  d.Set("clientrects_seed", base::NumberToString(p.seeds.client_rects));
+  d.Set("fonts", StringList(p.fonts));
+  d.Set("locale", p.locale);
+  d.Set("languages", StringList(p.languages));
+  d.Set("accept_language", p.accept_language);
+  if (p.geolocation) {
+    base::DictValue geo;
+    geo.Set("country", p.geolocation->country);
+    geo.Set("timezone", p.timezone);
+    geo.Set("latitude", p.geolocation->latitude);
+    geo.Set("longitude", p.geolocation->longitude);
+    geo.Set("accuracy_m", p.geolocation->accuracy_m);
+    d.Set("geo", std::move(geo));
+  }
+  d.Set("media_devices", std::move(media));
+  d.Set("webrtc_policy", p.webrtc_policy);
+
+  // DictValue keeps keys sorted, so the text is canonical. Only fails on
+  // binary values or excessive depth, neither of which is possible here.
+  std::optional<std::string> json = base::WriteJson(d);
+  CHECK(json);
+  return std::move(*json);
+}
+
+std::string EncodePersonaSwitchValue(const Persona& persona) {
+  const std::string json = SerializePersona(persona);
+  std::string out;
+  // The browser encodes during BasicStartupComplete, before base::FeatureList
+  // exists; the EarlyStartup variant does not consult features.
+  base::Base64UrlEncodeEarlyStartup(base::as_byte_span(json),
+                                    base::Base64UrlEncodePolicy::OMIT_PADDING,
+                                    &out);
+  return out;
+}
+
+std::unique_ptr<Persona> DecodePersonaSwitchValue(std::string_view value) {
+  if (value.empty() || value.size() > kMaxPersonaSwitchValueLength) {
+    return nullptr;
+  }
+  std::string json;
+  if (!base::Base64UrlDecode(value, base::Base64UrlDecodePolicy::DISALLOW_PADDING,
+                             &json)) {
+    return nullptr;
+  }
+  return ParsePersonaJson(json);
+}
+
+PersonaSwitchState ReadPersonaSwitch(const base::CommandLine& command_line,
+                                     std::unique_ptr<Persona>* persona) {
+  persona->reset();
+  // The browser process trusts only the signed --vanta-config.
+  if (!command_line.HasSwitch(kProcessTypeSwitch) ||
+      !command_line.HasSwitch(kPersonaSwitch)) {
+    return PersonaSwitchState::kAbsent;
+  }
+  *persona =
+      DecodePersonaSwitchValue(command_line.GetSwitchValueASCII(kPersonaSwitch));
+  return *persona ? PersonaSwitchState::kValid
+                  : PersonaSwitchState::kMalformed;
+}
+
+const Persona* GetPersona() {
+  if (const Persona* p = g_browser_persona.load(std::memory_order_acquire)) {
+    return p;
+  }
+  if (!base::CommandLine::InitializedForCurrentProcess() ||
+      !base::CommandLine::ForCurrentProcess()->HasSwitch(kProcessTypeSwitch)) {
+    // Browser process without a verified persona (or too early to tell).
+    return nullptr;
+  }
+  return GetChildPersona();
+}
+
+bool InitializeBrowserPersona(const base::DictValue& verified_payload) {
+  CHECK(!g_browser_persona.load(std::memory_order_acquire))
+      << "vanta: browser persona initialized twice";
+  std::unique_ptr<Persona> persona = PersonaFromDict(verified_payload);
+  if (!persona) {
+    LOG(ERROR) << "vanta: persona fields missing or invalid";
+    return false;
+  }
+  std::string value = EncodePersonaSwitchValue(*persona);
+  if (value.size() > kMaxPersonaSwitchValueLength) {
+    LOG(ERROR) << "vanta: persona too large for --" << kPersonaSwitch << " ("
+               << value.size() << " bytes)";
+    return false;
+  }
+  BrowserPersona& storage = GetBrowserPersonaStorage();
+  storage.switch_value = std::move(value);
+  storage.persona = std::move(persona);
+  g_browser_persona.store(storage.persona.get(), std::memory_order_release);
+  return true;
+}
+
+void AppendPersonaSwitch(base::CommandLine* child) {
+  if (!g_browser_persona.load(std::memory_order_acquire) ||
+      child->HasSwitch(kPersonaSwitch)) {
+    return;
+  }
+  child->AppendSwitchASCII(kPersonaSwitch,
+                           GetBrowserPersonaStorage().switch_value);
+}
+
+void ResetBrowserPersonaForTesting() {
+  g_browser_persona.store(nullptr, std::memory_order_release);
+  BrowserPersona& storage = GetBrowserPersonaStorage();
+  storage.persona.reset();
+  storage.switch_value.clear();
+}
