+      {"ua_ch.platform", "\"macOS\""},
+      {"ua_ch.mobile", "true"},
+      {"ua_ch.mobile", "\"false\""},
+      // Strings that would end up in headers.
+      {"user_agent", "\"Mozilla/5.0\\r\\nX-Evil: 1\""},
+      {"user_agent", "\"\""},
+      {"accept_language", "\"de\\nX: y\""},
+      // Brand lists.
+      {"ua_ch.brands", "[]"},
+      {"ua_ch.brands", "[[\"Chromium\"]]"},
+      {"ua_ch.brands", "[[\"Chromium\",\"156\",\"x\"]]"},
+      {"ua_ch.brands", "[[\"Chromium\",156]]"},
+      {"ua_ch.brands", "[{\"brand\":\"Chromium\",\"version\":\"156\"}]"},
+      // Hardware and screen.
+      {"hardware_concurrency", "0"},
+      {"hardware_concurrency", "\"12\""},
+      {"hardware_concurrency", "12.5"},
+      {"device_memory", "0"},
+      {"device_memory", "-8"},
+      {"device_memory", "\"8\""},
+      {"max_touch_points", "-1"},
+      {"screen.width", "0"},
+      {"screen.avail_width", "1921"},
+      {"screen.avail_height", "1081"},
+      {"screen.color_depth", "0"},
+      {"device_pixel_ratio", "0"},
+      {"device_pixel_ratio", "\"1\""},
+      // Graphics.
+      {"gpu.vendor", "\"\""},
+      {"gpu.renderer", "null"},
+      {"canvas", "\"fuzz\""},
+      {"webgl_image", "\"Noise\""},
+      {"audio", "1"},
+      // Seeds: decimal strings, non-zero, within u64.
+      {"canvas_seed", "8851769422948354661"},
+      {"canvas_seed", "\"0\""},
+      {"canvas_seed", "\"\""},
+      {"canvas_seed", "\"-1\""},
+      {"canvas_seed", "\"+1\""},
+      {"canvas_seed", "\" 1\""},
+      {"canvas_seed", "\"0x10\""},
+      {"canvas_seed", "\"1e3\""},
+      {"canvas_seed", "\"18446744073709551616\""},
+      {"font_seed", "null"},
+      // Fonts, locale and languages.
+      {"fonts", "[]"},
+      {"fonts", "[\"Arial\", \"\"]"},
+      {"fonts", "[\"Arial\", 1]"},
+      {"fonts", "\"Arial\""},
+      {"locale", "\"de_DE\""},
+      {"languages", "[]"},
+      {"languages", "[\"de-DE\", \"de;q=0.9\"]"},
+      {"languages", "[\"de-DE,de\"]"},
+      // Geo.
+      {"geo", "\"Europe/Berlin\""},
+      {"geo", "[]"},
+      {"geo.timezone", "\"\""},
+      {"geo.latitude", "91"},
+      {"geo.longitude", "-181"},
+      {"geo.accuracy_m", "-1"},
+      // Media devices.
+      {"media_devices.videoinput", "-1"},
+      {"media_devices.audioinput", "\"1\""},
+      // G8: one policy only.
+      {"webrtc_policy", "\"default\""},
+      {"webrtc_policy", "\"default_public_interface_only\""},
+  };
+  for (const Case& c : kCases) {
+    EXPECT_FALSE(WithValue(c.path, c.json)) << c.path << " = " << c.json;
+  }
+}
