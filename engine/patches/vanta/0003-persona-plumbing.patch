+TEST(VantaPersonaTest, CanonicalJsonRoundTrips) {
+  for (const char* json : {kPayload, kPayloadNoGeo}) {
+    std::unique_ptr<Persona> p = ParsePersonaJson(json);
+    ASSERT_TRUE(p);
+    const std::string canonical = SerializePersona(*p);
+    std::unique_ptr<Persona> back = ParsePersonaJson(canonical);
+    ASSERT_TRUE(back) << canonical;
+    EXPECT_EQ(*back, *p);
+    EXPECT_EQ(SerializePersona(*back), canonical);
+    // Only persona fields travel to children.
+    EXPECT_EQ(canonical.find("vanta_launch"), std::string::npos);
+    EXPECT_EQ(canonical.find("relay_port"), std::string::npos);
+    EXPECT_EQ(canonical.find("device_id"), std::string::npos);
+  }
+}
+
+TEST(VantaPersonaTest, SwitchValueRoundTrips) {
+  std::unique_ptr<Persona> p = ParsePersonaJson(kPayload);
+  ASSERT_TRUE(p);
+  const std::string value = EncodePersonaSwitchValue(*p);
+  EXPECT_LE(value.size(), kMaxPersonaSwitchValueLength);
+  EXPECT_EQ(value.find_first_of("+/="), std::string::npos);
+  std::unique_ptr<Persona> back = DecodePersonaSwitchValue(value);
+  ASSERT_TRUE(back);
+  EXPECT_EQ(*back, *p);
+}
