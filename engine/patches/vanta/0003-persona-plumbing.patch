+// ---- Process state ---------------------------------------------------------
+
+struct BrowserPersona {
+  std::unique_ptr<const Persona> persona;
+  std::string switch_value;
+};
+
+BrowserPersona& GetBrowserPersonaStorage() {
+  static base::NoDestructor<BrowserPersona> storage;
+  return *storage;
+}
+
+// Published once by InitializeBrowserPersona() before other threads start;
+// atomic anyway so a late reader never sees a half-built persona.
+std::atomic<const Persona*> g_browser_persona{nullptr};
+
+const Persona* GetChildPersona() {
+  if (!base::CommandLine::InitializedForCurrentProcess()) {
+    return nullptr;
+  }
+  // Thread-safe one-time initialization (C++11 magic statics).
+  static const Persona* const persona = []() -> const Persona* {
+    std::unique_ptr<Persona> parsed;
+    const PersonaSwitchState state =
+        ReadPersonaSwitch(*base::CommandLine::ForCurrentProcess(), &parsed);
+    // Fail closed: a child that cannot read the persona the browser gave it
+    // must not run with the host's real fingerprint.
+    CHECK(state != PersonaSwitchState::kMalformed)
+        << "vanta: --" << kPersonaSwitch << " is malformed";
+    // Lives as long as the process.
+    return parsed.release();
+  }();
+  return persona;
+}
