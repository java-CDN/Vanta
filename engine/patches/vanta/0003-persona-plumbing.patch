+            "(KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36");
+  EXPECT_EQ(p->brand, "Google Chrome");
+  EXPECT_EQ(p->platform, "Win32");
+
+  ASSERT_EQ(p->ua_ch.brands.size(), 3u);
+  EXPECT_EQ(p->ua_ch.brands[1].brand, "Chromium");
+  EXPECT_EQ(p->ua_ch.brands[1].version, "156");
+  ASSERT_EQ(p->ua_ch.full_version_list.size(), 3u);
+  EXPECT_EQ(p->ua_ch.full_version_list[2].brand, "Google Chrome");
+  EXPECT_EQ(p->ua_ch.full_version_list[2].version, "156.0.8078.79");
+  EXPECT_EQ(p->ua_ch.platform, "Windows");
