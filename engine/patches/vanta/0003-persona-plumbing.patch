+TEST(VantaPersonaTest, ReadPersonaSwitch) {
+  std::unique_ptr<Persona> expected = ParsePersonaJson(kPayload);
+  ASSERT_TRUE(expected);
+  const std::string value = EncodePersonaSwitchValue(*expected);
+  std::unique_ptr<Persona> out;
+
+  // The browser process (no --type) never trusts the switch.
+  base::CommandLine browser(base::CommandLine::NO_PROGRAM);
+  browser.AppendSwitchASCII(kPersonaSwitch, value);
+  EXPECT_EQ(ReadPersonaSwitch(browser, &out), PersonaSwitchState::kAbsent);
+  EXPECT_FALSE(out);
+
+  base::CommandLine plain_child(base::CommandLine::NO_PROGRAM);
+  plain_child.AppendSwitchASCII("type", "renderer");
+  EXPECT_EQ(ReadPersonaSwitch(plain_child, &out),
+            PersonaSwitchState::kAbsent);
+  EXPECT_FALSE(out);
+
+  base::CommandLine child(base::CommandLine::NO_PROGRAM);
+  child.AppendSwitchASCII("type", "gpu-process");
+  child.AppendSwitchASCII(kPersonaSwitch, value);
+  EXPECT_EQ(ReadPersonaSwitch(child, &out), PersonaSwitchState::kValid);
+  ASSERT_TRUE(out);
+  EXPECT_EQ(*out, *expected);
+
+  base::CommandLine bad_child(base::CommandLine::NO_PROGRAM);
+  bad_child.AppendSwitchASCII("type", "utility");
+  bad_child.AppendSwitchASCII(kPersonaSwitch, "e30");
+  EXPECT_EQ(ReadPersonaSwitch(bad_child, &out),
+            PersonaSwitchState::kMalformed);
+  EXPECT_FALSE(out);
+
+  base::CommandLine empty_child(base::CommandLine::NO_PROGRAM);
+  empty_child.AppendSwitchASCII("type", "renderer");
+  empty_child.AppendSwitch(kPersonaSwitch);
+  EXPECT_EQ(ReadPersonaSwitch(empty_child, &out),
+            PersonaSwitchState::kMalformed);
+}
