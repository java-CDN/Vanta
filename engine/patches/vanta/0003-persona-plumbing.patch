+TEST(VantaPersonaTest, MalformedSwitchValueIsNull) {
+  std::unique_ptr<Persona> p = ParsePersonaJson(kPayload);
+  ASSERT_TRUE(p);
+  const std::string good = EncodePersonaSwitchValue(*p);
+
+  EXPECT_FALSE(DecodePersonaSwitchValue(""));
+  EXPECT_FALSE(DecodePersonaSwitchValue("!!!!"));
+  EXPECT_FALSE(DecodePersonaSwitchValue(good + "="));  // padding
+  EXPECT_FALSE(DecodePersonaSwitchValue(good.substr(0, good.size() - 3)));
+  // Standard (not url-safe) base64 of the same JSON.
+  const std::string standard = base::Base64Encode(SerializePersona(*p));
+  if (standard.find_first_of("+/") != std::string::npos) {
+    EXPECT_FALSE(DecodePersonaSwitchValue(standard));
+  }
+  // Valid base64url, not a persona.
+  EXPECT_FALSE(DecodePersonaSwitchValue("e30"));  // "{}"
+  // Too long, even if it were valid.
+  EXPECT_FALSE(DecodePersonaSwitchValue(
+      std::string(kMaxPersonaSwitchValueLength + 1, 'A')));
+}
