+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_VANTA_CANVAS_NOISE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_VANTA_CANVAS_NOISE_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "base/containers/span.h"
+#include "base/memory/scoped_refptr.h"
+#include "third_party/blink/renderer/platform/platform_export.h"
+
+class SkPixmap;
+
+namespace blink {
+
+class StaticBitmapImage;
+
+namespace vanta_surfaces {
+
+// Seeded Canvas 2D readback noise (Vanta patch 0005), active only when the
+// persona's canvas mode is Noise. The rule, per pixel of the surface:
+//  - only fully opaque pixels, so premultiplied and unpremultiplied readbacks
+//    (encoders vs. getImageData) change in exactly the same way;
+//  - only pixels whose colour (ignoring the lowest bit) differs from every
+//    4-neighbour ON THE SURFACE: antialiased edges of text, arcs and emoji.
+//    Solid fills, rectangle edges and 1px lines read back exact;
+//  - one seeded bit, from (seed, surface x, surface y, colour), becomes the
+//    lowest bit of R, G and B, except channels at 0 or 255. Grey stays grey.
+// The decision for a pixel depends only on the seed, its absolute position
+// and the surface pixels around it, never on the rectangle being read: a
+// 1x1 read, any sub-rectangle and a full read (getImageData, readPixels,
+// toDataURL/toBlob) all return the same value for the same pixel.
+// Every decision reads colours without their lowest bit, which the noise
+// never changes, so applying it twice equals applying it once: reads are
+// stable, and getImageData -> putImageData -> getImageData is unchanged.
+//
+// The same rule serves WebGL readbacks (readPixels, toDataURL/toBlob of a
+// WebGL canvas) with the persona's webgl_image mode and webgl seed.
+// Mode Block: every readback of that surface is transparent black, the
+// pixels of a blank canvas, whatever was drawn.
+enum class ImageSurface { kCanvas2D, kWebGL };
+
+// True when readbacks of `surface` are changed (mode Noise or Block), so
+// callers can skip the extra read of the pixels around a readback.
+PLATFORM_EXPORT bool ReadbackNoiseActive(ImageSurface surface);
+
+// In place, on an 8888 (RGBA or BGRA) pixmap `out` whose pixel (0, 0) is
+// surface pixel (out_x, out_y). `around` holds the surface pixels the
+// decision reads: `out`'s on-surface part plus a 1-pixel border, clamped to
+// the surface (pixels outside `around` are outside the surface), with the
+// same colour type as `out`; its pixel (0, 0) is surface pixel
+// (around_x, around_y). Other colour types are left alone (Block clears
+// them too).
+PLATFORM_EXPORT void ApplyCanvasNoise(
+    const SkPixmap& out,
+    int out_x,
+    int out_y,
+    const SkPixmap& around,
+    int around_x,
+    int around_y,
+    ImageSurface surface = ImageSurface::kCanvas2D);
+
+// WebGL readPixels (RGBA, UNSIGNED_BYTE): `out` holds rows of `width`
+// pixels, `out_row_bytes` apart, bottom row first, for the GL rectangle
+// (x, y, width, height). `around` is the same kind of read of
+// (x - 1, y - 1, width + 2, height + 2) with `around_row_bytes`; pixels
+// outside the framebuffer must read as 0. For the default framebuffer pass
+// its size as `surface_width` x `surface_height`, which makes the decision
+// key the top-down position a toDataURL of the canvas uses; 0 x 0 for a
+// framebuffer object (GL coordinates as they are).
+PLATFORM_EXPORT void ApplyWebGLReadNoise(base::span<uint8_t> out,
+                                         size_t out_row_bytes,
+                                         int x,
+                                         int y,
+                                         int width,
+                                         int height,
+                                         base::span<const uint8_t> around,
+                                         size_t around_row_bytes,
+                                         int surface_width,
+                                         int surface_height);
+
+// For toDataURL/toBlob/convertToBlob: a noised (or, for Block, blank) raster
+// copy of `image`, or `image` itself when the surface's mode is Real or the
+// image is not 8888.
+PLATFORM_EXPORT scoped_refptr<StaticBitmapImage> ApplyCanvasNoise(
+    scoped_refptr<StaticBitmapImage> image,
+    ImageSurface surface = ImageSurface::kCanvas2D);
+
+}  // namespace vanta_surfaces
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_VANTA_CANVAS_NOISE_H_
