+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/vanta/canvas_noise.h"
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <algorithm>
+
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+#include "third_party/blink/renderer/platform/graphics/static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/graphics/unaccelerated_static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/vanta/vanta_persona.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+
+namespace blink::vanta_surfaces {
+
+namespace {
+
+uint64_t SurfaceSeed(ImageSurface surface) {
+  const PersonaSurfaces* p = GetPersonaSurfaces();
+  if (!p) {
+    return 0;
+  }
+  return surface == ImageSurface::kWebGL ? p->webgl_image_noise_seed
+                                         : p->canvas_noise_seed;
+}
+
+bool SurfaceBlocked(ImageSurface surface) {
+  const PersonaSurfaces* p = GetPersonaSurfaces();
+  if (!p) {
+    return false;
+  }
+  return surface == ImageSurface::kWebGL ? p->webgl_image_block
+                                         : p->canvas_block;
+}
+
+bool Is8888(SkColorType type) {
+  return type == kRGBA_8888_SkColorType || type == kBGRA_8888_SkColorType;
+}
+
+// Bytes an 8888 pixmap of `width` x `height` with `row_bytes` addresses.
+size_t SpanBytes(size_t row_bytes, int width, int height) {
+  if (width <= 0 || height <= 0) {
+    return 0;
+  }
+  return row_bytes * static_cast<size_t>(height - 1) +
+         static_cast<size_t>(width) * 4;
+}
+
+// Surface pixels the decision reads; pixel (0, 0) is surface (x, y).
+struct Around {
+  base::span<const uint8_t> px;
+  size_t row_bytes = 0;
+  int x = 0;
+  int y = 0;
+  int width = 0;
+  int height = 0;
+  size_t r = 0;  // Byte offset of R: 0 in RGBA, 2 in BGRA.
+  // When > 0, the surface size: positions outside it are never neighbours.
+  int surface_width = 0;
+  int surface_height = 0;
+
+  bool Has(int sx, int sy) const {
+    if (sx < x || sy < y || sx - x >= width || sy - y >= height) {
+      return false;
+    }
+    return surface_width <= 0 ||
+           (sx >= 0 && sy >= 0 && sx < surface_width && sy < surface_height);
+  }
+  size_t At(int sx, int sy) const {
+    return static_cast<size_t>(sy - y) * row_bytes +
+           static_cast<size_t>(sx - x) * 4;
+  }
+  // Colour without the lowest bit of R, G, B (and full alpha), RGBA order.
+  uint32_t Coarse(int sx, int sy) const {
+    const size_t i = At(sx, sy);
+    return uint32_t{px[i + r]} >> 1 | (uint32_t{px[i + 1]} >> 1) << 7 |
+           (uint32_t{px[i + 2 - r]} >> 1) << 14 | uint32_t{px[i + 3]} << 21;
+  }
+};
+
+// The pixels being returned; pixel (0, 0) is surface (x, y).
+struct Out {
+  base::span<uint8_t> px;
+  size_t row_bytes = 0;
+  int x = 0;
+  int y = 0;
+  int width = 0;
+  int height = 0;
+  size_t r = 0;
+};
+
+// `flip_height` > 0: surface y counts up from the bottom row (GL), and the
+// decision key uses the top-down row flip_height - 1 - y.
+void Noise(const Out& out, const Around& around, int flip_height,
+           uint64_t seed) {
+  static constexpr int kDx[] = {-1, 1, 0, 0};
+  static constexpr int kDy[] = {0, 0, -1, 1};
+  const size_t out_b = 2 - out.r;
+  for (int j = 0; j < out.height; ++j) {
+    for (int i = 0; i < out.width; ++i) {
+      const int sx = out.x + i;
+      const int sy = out.y + j;
+      if (!around.Has(sx, sy) || around.px[around.At(sx, sy) + 3] != 255) {
+        continue;
+      }
+      const uint32_t colour = around.Coarse(sx, sy);
+      bool has_neighbour = false;
+      bool isolated = true;
+      for (int n = 0; n < 4 && isolated; ++n) {
+        const int nx = sx + kDx[n];
+        const int ny = sy + kDy[n];
+        if (!around.Has(nx, ny)) {
+          continue;
+        }
+        has_neighbour = true;
+        isolated = around.Coarse(nx, ny) != colour;
+      }
+      if (!has_neighbour || !isolated) {
+        continue;
+      }
+      const int key_y = flip_height > 0 ? flip_height - 1 - sy : sy;
+      const uint64_t where = uint64_t{static_cast<uint32_t>(sx)} << 32 |
+                             static_cast<uint32_t>(key_y);
+      const uint8_t bit = Mix64(seed ^ Mix64(where ^ Mix64(colour))) & 1;
+      const size_t o = static_cast<size_t>(j) * out.row_bytes +
+                       static_cast<size_t>(i) * 4;
+      for (size_t c : {out.r, size_t{1}, out_b}) {
+        if (out.px[o + c] != 0 && out.px[o + c] != 255) {
+          out.px[o + c] = (out.px[o + c] & 0xfe) | bit;
+        }
+      }
+    }
+  }
+}
+
+Out OutOf(const SkPixmap& pixmap, int x, int y) {
+  Out out;
+  if (!pixmap.writable_addr()) {
+    return out;
+  }
+  // SAFETY: an SkPixmap addresses rowBytes() * (height - 1) + width * 4
+  // bytes of 8888 pixels.
+  out.px = UNSAFE_BUFFERS(
+      base::span(static_cast<uint8_t*>(pixmap.writable_addr()),
+                 SpanBytes(pixmap.rowBytes(), pixmap.width(),
+                           pixmap.height())));
+  out.row_bytes = pixmap.rowBytes();
+  out.x = x;
+  out.y = y;
+  out.width = out.px.empty() ? 0 : pixmap.width();
+  out.height = out.px.empty() ? 0 : pixmap.height();
+  out.r = pixmap.colorType() == kRGBA_8888_SkColorType ? 0 : 2;
+  return out;
+}
+
+Around AroundOf(const SkPixmap& pixmap, int x, int y) {
+  Around around;
+  if (!pixmap.addr()) {
+    return around;
+  }
+  // SAFETY: as in OutOf().
+  around.px = UNSAFE_BUFFERS(
+      base::span(static_cast<const uint8_t*>(pixmap.addr()),
+                 SpanBytes(pixmap.rowBytes(), pixmap.width(),
+                           pixmap.height())));
+  around.row_bytes = pixmap.rowBytes();
+  around.x = x;
+  around.y = y;
+  around.width = around.px.empty() ? 0 : pixmap.width();
+  around.height = around.px.empty() ? 0 : pixmap.height();
+  around.r = pixmap.colorType() == kRGBA_8888_SkColorType ? 0 : 2;
+  return around;
+}
+
+}  // namespace
+
+bool ReadbackNoiseActive(ImageSurface surface) {
+  return SurfaceBlocked(surface) || SurfaceSeed(surface) != 0;
+}
+
+void ApplyCanvasNoise(const SkPixmap& out,
+                      int out_x,
+                      int out_y,
+                      const SkPixmap& around,
+                      int around_x,
+                      int around_y,
+                      ImageSurface surface) {
+  if (SurfaceBlocked(surface)) {
+    out.erase(SK_ColorTRANSPARENT);
+    return;
+  }
+  const uint64_t seed = SurfaceSeed(surface);
+  if (!seed || !Is8888(out.colorType()) ||
+      around.colorType() != out.colorType()) {
+    return;
+  }
+  Noise(OutOf(out, out_x, out_y), AroundOf(around, around_x, around_y),
+        /*flip_height=*/0, seed);
+}
+
+void ApplyWebGLReadNoise(base::span<uint8_t> out,
+                         size_t out_row_bytes,
+                         int x,
+                         int y,
+                         int width,
+                         int height,
+                         base::span<const uint8_t> around,
+                         size_t around_row_bytes,
+                         int surface_width,
+                         int surface_height) {
+  if (width <= 0 || height <= 0) {
+    return;
+  }
+  const size_t out_bytes = SpanBytes(out_row_bytes, width, height);
+  if (out.size() < out_bytes) {
+    return;
+  }
+  if (SurfaceBlocked(ImageSurface::kWebGL)) {
+    for (int j = 0; j < height; ++j) {
+      std::ranges::fill(out.subspan(static_cast<size_t>(j) * out_row_bytes,
+                                    static_cast<size_t>(width) * 4),
+                        uint8_t{0});
+    }
+    return;
+  }
+  const uint64_t seed = SurfaceSeed(ImageSurface::kWebGL);
+  if (!seed ||
+      around.size() < SpanBytes(around_row_bytes, width + 2, height + 2)) {
+    return;
+  }
+  Around a;
+  a.px = around;
+  a.row_bytes = around_row_bytes;
+  a.x = x - 1;
+  a.y = y - 1;
+  a.width = width + 2;
+  a.height = height + 2;
+  a.surface_width = surface_width;
+  a.surface_height = surface_height;
+  Out o;
+  o.px = out.first(out_bytes);
+  o.row_bytes = out_row_bytes;
+  o.x = x;
+  o.y = y;
+  o.width = width;
+  o.height = height;
+  Noise(o, a, surface_height, seed);
+}
+
+scoped_refptr<StaticBitmapImage> ApplyCanvasNoise(
+    scoped_refptr<StaticBitmapImage> image,
+    ImageSurface surface) {
+  const bool block = SurfaceBlocked(surface);
+  const uint64_t seed = SurfaceSeed(surface);
+  if ((!seed && !block) || !image) {
+    return image;
+  }
+  scoped_refptr<StaticBitmapImage> raster = image->MakeUnaccelerated();
+  if (!raster) {
+    return image;
+  }
+  sk_sp<SkImage> source = raster->PaintImageForCurrentFrame().GetSwSkImage();
+  if (!source || (!block && !Is8888(source->colorType()))) {
+    return image;
+  }
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(source->imageInfo())) {
+    return image;
+  }
+  if (block) {
+    // Blank, same size and colour type: what an untouched canvas encodes to.
+    bitmap.eraseColor(SK_ColorTRANSPARENT);
+  } else {
+    if (!source->readPixels(bitmap.pixmap(), 0, 0)) {
+      return image;
+    }
+    // The whole image is the surface: it is its own neighbourhood.
+    Noise(OutOf(bitmap.pixmap(), 0, 0), AroundOf(bitmap.pixmap(), 0, 0),
+          /*flip_height=*/0, seed);
+  }
+  bitmap.setImmutable();
+  return UnacceleratedStaticBitmapImage::Create(
+      bitmap.asImage(), image->Orientation(), image->GetHdrMetadata());
+}
+
+}  // namespace blink::vanta_surfaces
