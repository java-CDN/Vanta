+// Copyright 2026 The Vanta Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/vanta/canvas_noise.h"
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+#include "third_party/blink/renderer/platform/graphics/static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/graphics/unaccelerated_static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/vanta/vanta_persona.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+
+namespace blink::vanta_surfaces {
+
+namespace {
+
+uint64_t SurfaceSeed(ImageSurface surface) {
+  const PersonaSurfaces* p = GetPersonaSurfaces();
+  if (!p) {
+    return 0;
+  }
+  return surface == ImageSurface::kWebGL ? p->webgl_image_noise_seed
+                                         : p->canvas_noise_seed;
+}
+
+bool SurfaceBlocked(ImageSurface surface) {
+  const PersonaSurfaces* p = GetPersonaSurfaces();
+  if (!p) {
+    return false;
+  }
+  return surface == ImageSurface::kWebGL ? p->webgl_image_block
+                                         : p->canvas_block;
+}
+
+bool Is8888(SkColorType type) {
+  return type == kRGBA_8888_SkColorType || type == kBGRA_8888_SkColorType;
+}
+
+void Noise(const SkPixmap& pixmap, int origin_x, int origin_y, uint64_t seed) {
+  const int width = pixmap.width();
+  const int height = pixmap.height();
+  const size_t row_bytes = pixmap.rowBytes();
+  if (width <= 0 || height <= 0 || !pixmap.writable_addr()) {
+    return;
+  }
+  // Byte offsets of R and B; G is 1 and A is 3 in both layouts.
+  const size_t r = pixmap.colorType() == kRGBA_8888_SkColorType ? 0 : 2;
+  const size_t b = 2 - r;
+  // SAFETY: an SkPixmap addresses rowBytes() * (height - 1) + width * 4 bytes.
+  base::span<uint8_t> px = UNSAFE_BUFFERS(
+      base::span(static_cast<uint8_t*>(pixmap.writable_addr()),
+                 row_bytes * (height - 1) + static_cast<size_t>(width) * 4));
+  auto at = [&](int x, int y) {
+    return static_cast<size_t>(y) * row_bytes + static_cast<size_t>(x) * 4;
+  };
+  // Colour without the lowest bit of R, G, B (and full alpha), in RGBA order.
+  auto coarse = [&](size_t i) -> uint32_t {
+    return uint32_t{px[i + r]} >> 1 | (uint32_t{px[i + 1]} >> 1) << 7 |
+           (uint32_t{px[i + b]} >> 1) << 14 | uint32_t{px[i + 3]} << 21;
+  };
+  static constexpr int kDx[] = {-1, 1, 0, 0};
+  static constexpr int kDy[] = {0, 0, -1, 1};
+  for (int y = 0; y < height; ++y) {
+    for (int x = 0; x < width; ++x) {
+      const size_t i = at(x, y);
+      if (px[i + 3] != 255) {
+        continue;
+      }
+      const uint32_t colour = coarse(i);
+      bool has_neighbour = false;
+      bool isolated = true;
+      for (int n = 0; n < 4 && isolated; ++n) {
+        const int nx = x + kDx[n];
+        const int ny = y + kDy[n];
+        if (nx < 0 || ny < 0 || nx >= width || ny >= height) {
+          continue;
+        }
+        has_neighbour = true;
+        isolated = coarse(at(nx, ny)) != colour;
+      }
+      if (!has_neighbour || !isolated) {
+        continue;
+      }
+      const uint64_t where =
+          uint64_t{static_cast<uint32_t>(origin_x + x)} << 32 |
+          static_cast<uint32_t>(origin_y + y);
+      const uint8_t bit = Mix64(seed ^ Mix64(where ^ Mix64(colour))) & 1;
+      for (size_t c : {r, size_t{1}, b}) {
+        if (px[i + c] != 0 && px[i + c] != 255) {
+          px[i + c] = (px[i + c] & 0xfe) | bit;
+        }
+      }
+    }
+  }
+}
+
+}  // namespace
+
+void ApplyCanvasNoise(const SkPixmap& pixmap,
+                      int origin_x,
+                      int origin_y,
+                      ImageSurface surface) {
+  if (SurfaceBlocked(surface)) {
+    pixmap.erase(SK_ColorTRANSPARENT);
+    return;
+  }
+  const uint64_t seed = SurfaceSeed(surface);
+  if (seed && Is8888(pixmap.colorType())) {
+    Noise(pixmap, origin_x, origin_y, seed);
+  }
+}
+
+scoped_refptr<StaticBitmapImage> ApplyCanvasNoise(
+    scoped_refptr<StaticBitmapImage> image,
+    ImageSurface surface) {
+  const bool block = SurfaceBlocked(surface);
+  const uint64_t seed = SurfaceSeed(surface);
+  if ((!seed && !block) || !image) {
+    return image;
+  }
+  scoped_refptr<StaticBitmapImage> raster = image->MakeUnaccelerated();
+  if (!raster) {
+    return image;
+  }
+  sk_sp<SkImage> source = raster->PaintImageForCurrentFrame().GetSwSkImage();
+  if (!source || (!block && !Is8888(source->colorType()))) {
+    return image;
+  }
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(source->imageInfo())) {
+    return image;
+  }
+  if (block) {
+    // Blank, same size and colour type: what an untouched canvas encodes to.
+    bitmap.eraseColor(SK_ColorTRANSPARENT);
+  } else {
+    if (!source->readPixels(bitmap.pixmap(), 0, 0)) {
+      return image;
+    }
+    Noise(bitmap.pixmap(), 0, 0, seed);
+  }
+  bitmap.setImmutable();
+  return UnacceleratedStaticBitmapImage::Create(
+      bitmap.asImage(), image->Orientation(), image->GetHdrMetadata());
+}
+
+}  // namespace blink::vanta_surfaces
